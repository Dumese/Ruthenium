{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ruthenium",
  "version": "0.1.0-rc.1",
  "identifier": "app.ruthenium.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ruthenium",
        "width": 1280,
        "height": 800,
        "minWidth": 560,
        "minHeight": 400,
        "decorations": false,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "../LICENSE"
    ],
    "shortDescription": "Ruthenium — local-first lightweight SSH client",
    "publisher": "Dumese",
    "longDescription": "Ruthenium is a local-first Windows SSH client: no account, no cloud sync, no telemetry. All state lives in a single editable hosts.toml.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "SimpChinese",
          "TradChinese",
          "English",
          "Japanese"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
